# === API Keys ===
GEMINI_API_KEY=your_gemini_key
VIRUSTOTAL_API_KEY=your_vt_key
SAFE_BROWSING_API_KEY=your_gsb_key
ABUSEIPDB_API_KEY=your_abuseipdb_key

# === Gmail OAuth (for deployment) ===
# Option 1: Use environment variables (recommended for Render/Railway)
# Get these by running: python backend/auth_gmail.py
# Then paste the values from credentials.json and token.pickle
GMAIL_CREDENTIALS_JSON={"installed":{"client_id":"YOUR_CLIENT_ID","project_id":"YOUR_PROJECT","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"YOUR_CLIENT_SECRET","redirect_uris":["http://localhost"]}}
GMAIL_REFRESH_TOKEN=YOUR_REFRESH_TOKEN_HERE

# Option 2: Use local files (for development)
# Place credentials.json in backend/credentials/
# Run python backend/auth_gmail.py to generate token.pickle

# === GeoIP ===
# Place GeoLite2-City.mmdb in data/ (download from MaxMind, free license)
# Register at https://www.maxmind.com/en/geolite2/signup

# === App Config ===
FLASK_SECRET_KEY=change-me-in-production
DEBUG_MODE=true
PORT=5000
